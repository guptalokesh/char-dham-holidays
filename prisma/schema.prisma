generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MediaPurpose {
  IMAGE
  PDF
}

enum RoomAvailabilityStatus {
  AVAILABLE
  BOOKED
  UNAVAILABLE
}

enum EnquiryService {
  GENERAL
  CHARDHAM
  TREKKING
  FARM_HOME_STAY
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WebsiteSettings {
  id String @id @default(cuid())

  // Business
  businessName     String  @default("Char Dham Holidays")
  shortDescription String?
  addressLine      String?
  city             String?
  state            String?
  country          String?
  mapLink          String?

  // Contact
  primaryPhone   String?
  secondaryPhone String?
  whatsappNumber String?
  primaryEmail   String?
  enquiryEmail   String?

  // Social
  instagramUrl   String?
  facebookUrl    String?
  youtubeUrl     String?
  otherSocialUrl String?

  // Branding
  logoMediaId         String? @unique
  logoMedia           Media?  @relation("SettingsLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  faviconMediaId      String? @unique
  faviconMedia        Media?  @relation("SettingsFavicon", fields: [faviconMediaId], references: [id], onDelete: SetNull)
  primaryColor        String  @default("#1B4B66")
  secondaryColor      String  @default("#E08A2C")
  trekkingAccentColor String  @default("#2F6B3A")

  // Website content
  heroHeading         String? @default("Explore Uttarakhand")
  heroDescription     String? @default("Spiritual journeys, mountain treks and peaceful stays.")
  chardhamCtaLabel    String? @default("Explore Chardham")
  trekkingCtaLabel    String? @default("Explore Treks")
  whatsappCtaText     String? @default("Chat on WhatsApp")
  contactCtaText      String? @default("Send an Enquiry")
  footerCopyrightText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id       String       @id @default(cuid())
  url      String
  filename String
  mimeType String
  size     Int
  purpose  MediaPurpose

  chardhamPackageId String?
  chardhamPackage   ChardhamPackage? @relation(fields: [chardhamPackageId], references: [id], onDelete: Cascade)

  trekId String?
  trek   Trek?   @relation(fields: [trekId], references: [id], onDelete: Cascade)

  farmPropertyId String?
  farmProperty   FarmProperty? @relation(fields: [farmPropertyId], references: [id], onDelete: Cascade)

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  settingsLogo    WebsiteSettings? @relation("SettingsLogo")
  settingsFavicon WebsiteSettings? @relation("SettingsFavicon")

  createdAt DateTime @default(now())

  @@index([chardhamPackageId])
  @@index([trekId])
  @@index([farmPropertyId])
  @@index([roomId])
}

model ChardhamPackage {
  id               String   @id @default(cuid())
  name             String   @default("Chardham Yatra by Helicopter")
  price            Int
  destinations     String[]
  stayInfo         String
  foodInfo         String
  travelInfo       String
  travelPeriod     String?
  routeOverview    String?
  importantInfo    String?
  itineraryMediaId String?
  active           Boolean  @default(true)

  images Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Trek {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  description      String
  price            Int?
  itineraryMediaId String?
  active           Boolean @default(true)
  order            Int     @default(0)

  images    Media[]
  enquiries Enquiry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FarmProperty {
  id                String  @id @default(cuid())
  description       String
  location          String?
  mapLink           String?
  amenities         Json?
  guestCapacityNote String?
  active            Boolean @default(true)

  images Media[]
  rooms  Room[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id             String       @id @default(cuid())
  farmPropertyId String
  farmProperty   FarmProperty @relation(fields: [farmPropertyId], references: [id], onDelete: Cascade)
  name           String
  price          Int
  capacity       Int
  amenities      Json?
  active         Boolean      @default(true)

  images       Media[]
  availability RoomAvailability[]
  enquiries    Enquiry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmPropertyId])
}

model RoomAvailability {
  id     String                 @id @default(cuid())
  roomId String
  room   Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date   DateTime               @db.Date
  status RoomAvailabilityStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, date])
  @@index([roomId, date])
}

model Enquiry {
  id      String         @id @default(cuid())
  name    String
  phone   String
  email   String?
  service EnquiryService
  message String?
  details Json?

  trekId String?
  trek   Trek?   @relation(fields: [trekId], references: [id], onDelete: SetNull)

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  status EnquiryStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([service])
  @@index([createdAt])
}
