# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/chardham?schema=public"

# --- Admin session ---
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32-byte-secret"

# --- Admin bootstrap ---
# Read only by `npx prisma db seed`, and only to create the admin user the
# first time (it upserts by email and never overwrites an existing user's
# password). If ADMIN_PASSWORD is left unset, the seed script creates a
# dev-only admin login and prints it to the console — do not leave it unset
# before seeding production. There is no in-app "change password" feature
# yet (V1 scope); to rotate the password later, update AdminUser.passwordHash
# directly (a bcrypt hash) or reset the database and reseed.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# --- SMTP (used for enquiry notifications + customer acknowledgement emails) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Char Dham Holidays <no-reply@example.com>"

# --- File storage ---
# "local" writes into UPLOAD_DIR, served directly by Next.js as a static
# path — works on any VPS/Docker host with a persistent filesystem.
# "s3" writes to an S3-compatible bucket — required on serverless hosts
# (e.g. Vercel) where the filesystem is ephemeral and not shared across
# instances.
STORAGE_DRIVER="local"
UPLOAD_DIR="./public/uploads"

# Only required when STORAGE_DRIVER=s3
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
