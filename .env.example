# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/chardham?schema=public"

# --- Admin session ---
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32-byte-secret"

# --- SMTP (used for enquiry notifications + customer acknowledgement emails) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Char Dham Holidays <no-reply@example.com>"

# --- File storage ---
# "local" writes to the ./uploads directory (works on any VPS/Docker host).
# "s3" writes to an S3-compatible bucket (required on serverless hosts with an ephemeral filesystem).
STORAGE_DRIVER="local"
UPLOAD_DIR="./public/uploads"

# Only required when STORAGE_DRIVER=s3
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
